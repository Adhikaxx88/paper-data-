# Optional: only needed if you point embedder/generator back at OpenAI
OPENAI_API_KEY=

# Use "localhost" for a locally-run stack, or the "postgres"/"qdrant" service
# names (as below) when running via docker-compose.
POSTGRES_URL=postgresql://user:password@postgres:5432/newsrag
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials.json
NEWS_KEYWORDS=pinjol,fintech,kredit digital

# Postgres container settings (used by docker-compose.yml)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=newsrag

# Embedding (infinity-emb, BGE)
INFINITY_URL=http://infinity:7997
EMBED_MODEL=BAAI/bge-large-en-v1.5
EMBED_DIM=1024

# Generation (Ollama)
OLLAMA_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.1
